# ==============================================================================
# RunPod GPU Production Environment Configuration Template
# ==============================================================================
# Copy this file to your RunPod Environment Variables when deploying your Pod.
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
PORT=8000
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. RunPod Persistent Volume Paths
# ------------------------------------------------------------------------------
# Mount a persistent RunPod Network Volume to /workspace
HF_HOME=/workspace/models/huggingface
TORCH_HOME=/workspace/models/torch
MUSCRIPTOR_CACHE_DIR=/workspace/models/muscriptor
DEMUCS_CACHE=/workspace/models/demucs

# ------------------------------------------------------------------------------
# 3. Hugging Face Authentication (Required for MuScriptor Large)
# ------------------------------------------------------------------------------
# Request access at: https://huggingface.co/MuScriptor/muscriptor-large
# Obtain your token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_actual_huggingface_token_here

# ------------------------------------------------------------------------------
# 4. Cloudflare R2 Production Object Storage
# ------------------------------------------------------------------------------
# Create an R2 bucket in your Cloudflare dashboard and generate S3 API credentials.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_BUCKET_NAME=music-transcription
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT_URL=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com
R2_REGION=auto

# ------------------------------------------------------------------------------
# 5. External Speech-to-Text API (Vocal Lyrics Recognition)
# ------------------------------------------------------------------------------
# Supported providers: openrouter, groq, openai, deepgram
STT_PROVIDER=openrouter
STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Alternative STT providers (optional):
# GROQ_API_KEY=gsk_your_groq_api_key_here
# OPENAI_API_KEY=sk-your_openai_api_key_here
# DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# 6. Database Persistence
# ------------------------------------------------------------------------------
# Production PostgreSQL connection string (e.g. Supabase, Neon, AWS RDS, or RunPod Postgres)
DATABASE_URL=postgresql://username:password@your-postgres-host:5432/music_transcription

# For single-pod standalone testing on RunPod without external Postgres:
# DATABASE_URL=sqlite:////workspace/music_transcription.db

# ------------------------------------------------------------------------------
# 7. Redis Queue & Message Broker (Optional / Microservices Mode)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis-host:6379/0
