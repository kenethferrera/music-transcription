# ============================================================
# AI MUSIC TRANSCRIPTION WEB APPLICATION ENVIRONMENT TEMPLATE
# Copy to .env and provide your production credentials.
# NEVER commit .env to version control.
# ============================================================

# 1. ENVIRONMENT MODE
ENVIRONMENT=production
DEBUG=false
PORT=8000
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000,http://localhost:5173

# 2. STORAGE PROVIDER (r2 for production, local for offline dev)
STORAGE_PROVIDER=r2
LOCAL_STORAGE_DIR=storage_data

# 3. CLOUDFLARE R2 PRODUCTION OBJECT STORAGE
# Required for production uploads, separated stems, arrangements, and exports
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=music-transcription
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_REGION=auto

# 4. EXTERNAL STT API FOR LYRICS (openrouter, groq, openai, deepgram, or mock)
# External API only - no local Whisper weights
STT_PROVIDER=openrouter
STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Alternative STT providers (optional):
# GROQ_API_KEY=gsk_your_groq_api_key_here
# OPENAI_API_KEY=sk-your_openai_api_key_here
# DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 5. HUGGING FACE TOKEN (Required for MuScriptor Large license acceptance)
# MuScriptor Large is gated under CC BY-NC 4.0
HF_TOKEN=hf_your_huggingface_user_access_token

# 6. MODEL CACHE DIRECTORIES (Persistent RunPod Network Volume)
HF_HOME=/workspace/models/huggingface
TORCH_HOME=/workspace/models/torch
MUSCRIPTOR_CACHE_DIR=/workspace/models/muscriptor
DEMUCS_CACHE=/workspace/models/demucs

# 7. DATABASE PERSISTENCE & QUEUE
DATABASE_URL=postgresql://postgres:password@localhost:5432/transcription
POSTGRES_PASSWORD=postgres
REDIS_URL=redis://localhost:6379/0

# 8. WORKER CONCURRENCY & GPU LIMITS
MAX_CONCURRENT_GPU_JOBS=1
FORCE_SEQUENTIAL_INFERENCE=true
