# ============================================================
# AI MUSIC TRANSCRIPTION WEB APPLICATION ENVIRONMENT TEMPLATE
# Copy to .env and provide your production credentials.
# NEVER commit .env to version control.
# ============================================================

# 1. STORAGE PROVIDER (r2 for production, local for offline dev)
STORAGE_PROVIDER=r2
LOCAL_STORAGE_DIR=storage_data

# 2. CLOUDFLARE R2 PRODUCTION OBJECT STORAGE
# Required for production uploads, separated stems, arrangements, and exports
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=your_production_r2_bucket
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_REGION=auto

# 3. EXTERNAL STT API FOR LYRICS (groq, openai, deepgram, or mock)
# External API only - no local Whisper weights
STT_PROVIDER=groq
# STT_API_KEY can be used universally, or set specific provider keys:
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
STT_MODEL=whisper-large-v3

# 4. HUGGING FACE TOKEN (Required for MuScriptor Large license acceptance)
# MuScriptor Large is gated under CC BY-NC 4.0
HF_TOKEN=hf_your_huggingface_user_access_token

# 5. MODEL CACHE DIRECTORIES
TORCH_HOME=/models/torch
DEMUCS_CACHE=/models/demucs
HF_HOME=/models/huggingface
MUSCRIPTOR_CACHE_DIR=/models/muscriptor

# 6. APPLICATION & SERVER SETTINGS
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcription
POSTGRES_PASSWORD=postgres

# 7. WORKER CONCURRENCY & GPU LIMITS
MAX_CONCURRENT_GPU_JOBS=1
FORCE_SEQUENTIAL_INFERENCE=true

